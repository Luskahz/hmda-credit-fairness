# Ambientes virtuais e arquivos gerados pelo Python
/.venv/
/venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Arquivos locais do editor e do sistema
/.idea/
/.vscode/
.DS_Store
Thumbs.db

# Checkpoints do Jupyter
.ipynb_checkpoints/

# Dados locais do HMDA e saídas dos notebooks
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/hmda_multiano/
/data/processed/hmda_multiano/*
!/data/processed/hmda_multiano/hmda_[0-9][0-9][0-9][0-9]_valid18.parquet
!/data/processed/hmda_multiano/particoes_por_ano.csv
/reports/local/
/reports/colab/

# Configuração local
.env
.env.*
!.env.example

